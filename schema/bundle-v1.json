{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "scenario", "source", "mode", "environment", "packaged_at", "runtime", "artifacts", "limitations", "reproduce", "configuration_hash", "input_hashes"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "scenario": {"enum": ["seller-application", "seller-support-review", "seller-stale", "seller-suppressed", "seller-delivery", "seller-live", "control-recovery", "revenue-bridge", "revenue-correction", "connected-roundtrip"]},
    "source": {"type": "object", "additionalProperties": false, "required": ["repository", "commit"], "properties": {"repository": {"type": "string"}, "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}}},
    "mode": {"enum": ["recorded", "fresh_replay", "fresh_engine", "fresh_inference"]},
    "environment": {"const": "independent_synthetic_environment"},
    "packaged_at": {"type": "string", "format": "date-time"},
    "runtime": {"type": "object", "minProperties": 2},
    "artifacts": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "bytes"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "bytes": {"type": "integer", "minimum": 1}}}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "reproduce": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "configuration_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "input_hashes": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
  }
}
